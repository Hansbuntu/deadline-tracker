# Settings the app needs. Copy this file to .env.local and fill in the values
# from your Supabase project. .env.local is in .gitignore, so it never reaches GitHub.
# This example file has no real values, so it is safe to commit.

# Your project's address, like https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The PUBLISHABLE key (starts with sb_publishable_). It is public by design:
# row-level security decides what it can do. Never put the SECRET key here:
# anything starting with VITE_ is built into the website for anyone to read.
VITE_SUPABASE_PUBLISHABLE_KEY=
